# Copy to .env for local development. Never commit real values.

ENVIRONMENT=development          # "production" => webhook refuses to run without a secret
LOG_LEVEL=INFO
LOG_PII=true                     # false masks patient data in logs

# SQLite locally; use a Postgres URL in production (postgres:// and postgresql:// both work).
DATABASE_URL=sqlite:///./data/patients.db
SEED_DEMO_DATA=true

# Shared secret Vapi sends in the X-Vapi-Secret header. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
VAPI_WEBHOOK_SECRET=
# Optional: require X-API-Key on /patients endpoints.
API_KEY=

CLINIC_NAME=Riverside Family Clinic

# Only used by scripts/create_vapi_assistant.py
PUBLIC_BASE_URL=https://your-app.example.com
VAPI_API_KEY=
VAPI_ASSISTANT_ID=               # filled in after the first run so re-runs update in place
VAPI_VOICE_PROVIDER=openai
VAPI_VOICE_ID=alloy
VAPI_LLM_PROVIDER=openai
VAPI_LLM_MODEL=gpt-4o
VAPI_TRANSCRIBER_LANGUAGE=en     # "multi" enables Spanish but may mis-hear accented English
